# TimesFM Forecast Service Configuration

# Bearer token required for all authenticated routes (/v1/forecast).
# Generate a secure key with: python3 -c "import secrets; print(secrets.token_hex(32))"
FORECAST_API_KEY=

# Port uvicorn binds to (default: 8090)
FORECAST_PORT=8090

# Load the model at service startup instead of waiting for first request.
# Cold load takes ~45 seconds; set to 1 to avoid first-request latency.
FORECAST_WARM_AT_BOOT=1

# Optional: Hugging Face API token to avoid rate limits on checkpoint downloads.
# Get token at https://huggingface.co/settings/tokens
# HF_TOKEN=
